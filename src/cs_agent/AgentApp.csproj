<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>RemoteControlAgent</AssemblyName>
    <RootNamespace>RemoteControl</RootNamespace>
    <Version>1.0.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <!-- Minimal native DLLs: static rc_core + SDL2 only -->
  <ItemGroup>
    <Content Include="..\..\publish_v2\rc_core.dll">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\publish_v2\SDL2.dll">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\cs\*.cs" Exclude="..\cs\Program.cs;..\cs\HostForm.cs;..\cs\MainForm.cs;..\cs\ViewerForm.cs;..\cs\LoginForm.cs;..\cs\SettingsForm.cs;..\cs\ScheduledTasksForm.cs;..\cs\Action*.cs;..\cs\QuickOpsForm.cs;..\cs\StatsForm.cs;..\cs\ThumbnailClient.cs;..\cs\RealTimeMonitor.cs;..\cs\UpgradeCheck.cs;..\cs\TerminalForm.cs;..\cs\ChatForm.cs;..\cs\FileBrowserForm.cs;..\cs\FileTransferForm.cs;..\cs\AnnotationOverlay.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
